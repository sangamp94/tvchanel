# ---- Neon Postgres ----
# Get this from your Neon project dashboard (Connection Details -> Connection string)
# Must include "?sslmode=require" at the end
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ---- Admin dashboard login ----
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_password

# ---- Schedule source ----
# Schedule source: "url" (default, backward-compatible) or "database" (Neon channel_schedule row)
# In database mode, SCHEDULE_SOURCE_URL bootstraps Neon only if channel_schedule is empty.
SCHEDULE_SOURCE_MODE=url
SCHEDULE_SOURCE_URL=https://raw.githubusercontent.com/yourname/yourrepo/main/data/schedule.example.json
SCHEDULE_REFRESH_SECONDS=60

# ---- Video encode quality (tune these down if you see lag/frame drops on free hosting) ----
STREAM_WIDTH=854
STREAM_HEIGHT=480
STREAM_FPS=25
STREAM_THREADS=2
STREAM_PRESET=ultrafast
VIDEO_BITRATE=800k
VIDEO_BUFSIZE=1600k
AUDIO_BITRATE=96k

# ---- Port (Render sets this automatically, no need to change) ----
PORT=10000
